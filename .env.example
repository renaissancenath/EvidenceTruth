# Copy to .env (never commit .env). Every key is read with the ET_ prefix by backend/app/config.py.
ET_ENV=production
ET_SECRET_KEY=                       # 64+ random characters: python -c "import secrets;print(secrets.token_urlsafe(48))"
ET_PUBLIC_URL=https://your-domain.example
ET_EXTENSION_IDS=                    # your Chrome Web Store / Edge Add-ons extension ID(s), comma separated
ET_DATABASE_URL=postgresql://user:password@host:5432/evidencetruth

# Email: magic links and bug reports. resend (HTTP API) or smtp.
ET_EMAIL_BACKEND=resend
ET_EMAIL_FROM=EvidenceTruth <no-reply@your-domain.example>
ET_RESEND_API_KEY=
ET_SMTP_HOST=
ET_SMTP_PORT=587
ET_SMTP_USER=
ET_SMTP_PASSWORD=
ET_SUPPORT_EMAIL=support@your-domain.example
ET_CONTACT_EMAIL=support@your-domain.example   # sent in the User-Agent to Wikipedia and Crossref, as their policies ask

# Google sign-in (optional). Redirect URI: <ET_PUBLIC_URL>/v1/auth/google/callback
ET_GOOGLE_CLIENT_ID=
ET_GOOGLE_CLIENT_SECRET=

# Stripe (optional until you sell). Webhook URL: <ET_PUBLIC_URL>/v1/billing/webhook
# Events: checkout.session.completed, customer.subscription.created/updated/deleted
ET_STRIPE_SECRET_KEY=
ET_STRIPE_WEBHOOK_SECRET=
ET_STRIPE_PRICE_PRO=                 # price_... of a monthly recurring price
ET_PRO_PRICE_LABEL=$8 per month      # shown on the pricing page; must match the Stripe price
ET_FREE_CHECKS_PER_MONTH=50
ET_PRO_CHECKS_PER_MONTH=2000
ET_FREE_DOCUMENTS=3
ET_PRO_DOCUMENTS=200

# Verifier: lexical (default, CPU-cheap) or nli (needs requirements-ml.txt, ~1 GB RAM)
ET_VERIFIER=lexical
# Optional LLM for explanations only (OpenAI-compatible endpoint, e.g. Ollama http://127.0.0.1:11434/v1)
ET_LLM_BASE_URL=
ET_LLM_MODEL=
ET_LLM_API_KEY=
ET_SEMANTIC_SCHOLAR_KEY=

# Web search (optional): a SearXNG instance you run, with JSON output enabled. Keep its Google engine off (D-018).
ET_SEARXNG_URL=
ET_SEARXNG_ENGINES=

# Desktop app releases (set after the desktop-release workflow publishes one; empty = no download button)
ET_DESKTOP_LATEST_VERSION=
ET_DESKTOP_MIN_VERSION=0.0.0
ET_DESKTOP_DOWNLOAD_URL=
ET_DESKTOP_UPDATE_FEED_URL=

# Error monitor: any Sentry-compatible DSN (self-hosted GlitchTip recommended). Built-in grouping works without it.
ET_SENTRY_DSN=
ET_GITHUB_REPO=owner/EvidenceTruth   # for "Report a problem" GitHub links and the triage agent

# Private engine tuning file (optional). Default: backend/private_config/tuning.json if present, else public values.
ET_TUNING_FILE=
