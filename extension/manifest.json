{
  "manifest_version": 3,
  "name": "EvidenceTruth",
  "version": "0.1.0",
  "description": "Checks AI answers against sources. Reads only sites you allow, only when you press Scan.",
  "minimum_chrome_version": "116",
  "action": { "default_popup": "popup.html", "default_title": "EvidenceTruth", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "worker.js", "type": "module" },
  "permissions": ["storage", "sidePanel", "contextMenus", "activeTab", "scripting"],
  "host_permissions": ["__API_ORIGIN__/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
